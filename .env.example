# ─── Django (backend-pjt) ───────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string
DEBUG=True                       # 프로덕션에서는 False (기본값도 False)
ALLOWED_HOSTS=*

# Database — 둘 중 하나의 방식 사용
# 1) 접속 URL 한 줄 (Neon 등):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# 2) 개별 항목:
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
# DB_SSLMODE=require
# DB_CHANNEL_BINDING=require

# 교차 출처 배포 시 (프론트가 다른 도메인일 때)
# CORS_ALLOWED_ORIGINS=https://your-frontend.pages.dev
# CSRF_TRUSTED_ORIGINS=https://your-frontend.pages.dev

# AI — 챗봇/뉴스 요약 (Google AI Studio에서 무료 발급: https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=                # 선택: 챗봇 2차 폴백

# Elasticsearch (선택 — 비우면 Postgres 검색 폴백 사용)
ELASTICSEARCH_HOSTS=
ELASTICSEARCH_BONDS_INDEX=bonds_search
ELASTICSEARCH_GLOSSARY_INDEX=glossary_search

# ─── 데이터 파이프라인 (data-pjt) 전용 ──────────────────────────
DATA_PORTAL_API_KEY=
ECOS_API_KEY=
FSS_API_KEY=

# ─── Frontend (frontend-pjt) 빌드 시 ────────────────────────────
# VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1
